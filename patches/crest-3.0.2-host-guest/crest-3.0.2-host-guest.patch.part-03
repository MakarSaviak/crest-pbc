+    end if
+    inquire(file=trim(arg(1)),exist=ex)
+    if(.not.ex) error stop '**ERROR** external-rerank seed file not found'
+    env%inputcoords=trim(arg(1))
+  else
+    call find_input_file(arg,nra,idum)
+    if(idum.ne.0)then
