+      end if
+
 ! take the input
     else
 
@@ -1510,5 +1517,31 @@ contains  !> MODULE PROCEDURES START HERE
 
   end function amideH
 
+!========================================================================================!
+!========================================================================================!
+  subroutine prune_cross_fragment_neighbors(natoms,fraglist,nb)
+    integer,intent(in) :: natoms
+    integer,intent(in) :: fraglist(natoms)
+    integer,intent(inout) :: nb(20,natoms)
+    integer :: i,k,j,nold,nnew
+    integer :: kept(18)
+
+    do i = 1,natoms
+      kept = 0
+      nnew = 0
+      nold = min(max(nb(20,i),0),18)
+      do k = 1,nold
+        j = nb(k,i)
+        if (j < 1.or.j > natoms) cycle
+        if (fraglist(j) /= fraglist(i)) cycle
+        nnew = nnew+1
+        kept(nnew) = j
+      end do
+      nb(1:18,i) = 0
+      if (nnew > 0) nb(1:nnew,i) = kept(1:nnew)
+      nb(20,i) = nnew
+    end do
+  end subroutine prune_cross_fragment_neighbors
+
 !========================================================================================!
 end module gfnff_ini2
