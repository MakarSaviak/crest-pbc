+               d8 = -8*r2**3*t8**2
+               ddisp = (d6 + 2*r4r2ij*d8) * zeta_scale(ij)*dispscale
+               dG = -c6(iat, jat)*ddisp*rij
+               if (.not.frozen_mask(iat)) gradient(:, iat) = gradient(:, iat) + dG
+               if (.not.frozen_mask(jat)) gradient(:, jat) = gradient(:, jat) - dG
+            end if
+         endif
+      enddo
+      !$omp end parallel do
+   else
    !$omp parallel do default(none) schedule(runtime) &
