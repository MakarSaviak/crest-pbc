+      do img = 1, npair
+         iat = pairlist(1, img)
+         jat = pairlist(2, img)
+         ij = jat + iat*(iat-1)/2
+         ati = at(iat)
+         atj = at(jat)
+         rij = xyz(:, iat) - xyz(:, jat)
+         r2 = sum(rij**2)
+
+         r4r2ij = 3*r4r2(ati)*r4r2(atj)
+         r0 = radii(lin(ati, atj))
+
