+         dEdcn(iat) = dEdcn(iat) - dc6dcn(iat, jat) * disp
+         if (iat /= jat) then
+            energies(jat) = energies(jat) + dE
+            dEdcn(jat) = dEdcn(jat) - dc6dcn(jat, iat) * disp
+
+            ! CN-dependent D3 forces are retained below through dEdcn and dcndr.
+            ! Only the direct pair force has no active endpoint for a
+            ! frozen--frozen pair.
+            if (.not.(frozen_mask(iat).and.frozen_mask(jat))) then
