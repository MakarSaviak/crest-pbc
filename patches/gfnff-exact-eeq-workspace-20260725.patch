+        self%eeq_frozen_block(j,i) = tmp/r(ij)
+        self%eeq_frozen_block(i,j) = self%eeq_frozen_block(j,i)
+      end do
+    end do
+    self%eeq_frozen_block_valid = .true.
+  end subroutine gfnff_workspace_prepare_eeq_frozen_block
